# Copy to backend/.env.local. Node 22+ loads it automatically.
# Existing process environment variables take precedence.
MEMBERS_PROVIDER=supabase
SUPABASE_URL=https://nstrlskhvbugtbrzykbk.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_O2i_QJeiSzJ_rwTvSCGVLA_gFn3Zlfs
