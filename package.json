{
  "name": "caesar-site",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=frontend\" \"npm run dev --workspace=backend\"",
    "build": "npm run build --workspace=frontend && npm run build --workspace=backend",
    "start": "node backend/dist/index.js",
    "check:homepage": "node scripts/check-homepage.mjs",
    "check:partners": "node scripts/check-partners.mjs",
    "check:hero-layout": "node scripts/check-hero-layout.mjs",
    "check:support": "node scripts/check-support.mjs",
    "check:projects": "node scripts/check-projects.mjs",
    "check:members": "node scripts/check-members.mjs",
    "check:supabase": "node scripts/check-supabase.mjs",
    "check:supabase:live": "node scripts/check-supabase-live.mjs",
    "members:create-admin": "npm run build --workspace=backend && node backend/dist/create-admin.js",
    "check:navigation": "node scripts/check-navigation.mjs",
    "check:rocket": "node scripts/check-rocket.mjs",
    "check:avionics": "node scripts/check-avionics.mjs",
    "check:electronics": "node scripts/check-electronics.mjs",
    "check:propulsion": "node scripts/check-propulsion.mjs",
    "check:propulsion-page": "node scripts/check-propulsion-page.mjs",
    "check:structures": "node scripts/check-structures.mjs",
    "check:structures-page": "node scripts/check-structures-page.mjs",
    "check:marketing": "node scripts/check-marketing.mjs",
    "check:marketing-page": "node scripts/check-marketing-page.mjs",
    "check:scroll-motion": "node scripts/check-scroll-motion.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "concurrently": "^8.2.0",
    "playwright": "^1.63.0"
  }
}
